{
  "manifest_version": 3,
  "name": "Hermes Finder",
  "version": "2.2.0",
  "description": "__MSG_extDesc__",
  "author": "Jakub Krawiec, Mikołaj Kolański",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "shared/langdetect.js",
      "shared/i18n.js",
      "shared/settings.js",
      "shared/api.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/langdetect.js",
        "shared/i18n.js",
        "shared/settings.js",
        "shared/claims.js",
        "shared/render.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "content/page.css"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_cmdDesc__"
    }
  },
  "permissions": [
    "storage",
    "menus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "teza-w-danych@climate-verifier.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel/*",
        "shared/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "default_locale": "en",
  "homepage_url": "https://hermesfinder.us"
}
